rules_version = '2';
// Fotos de servicios y trabajos: todos pueden verlas, solo el dueño puede subirlas.
service firebase.storage {
  match /b/{bucket}/o {
    match /images/{file} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['samistotelesrico777@gmail.com']
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
